# Copy to .env and adjust. Never commit the filled-in version.
POSTGRES_USER=catalog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=catalog

DATABASE_URL=postgresql+psycopg://catalog:change-me@db:5432/catalog
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
SEED_ON_STARTUP=true

# Required by POST /equipment. Leave it empty and writes answer 503.
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=local-dev-key-change-me

VITE_API_URL=http://localhost:8000
