{
  // The public static demo: `npm run build:demo`, then `npx wrangler deploy`.
  // Served as Workers static assets on the account's workers.dev subdomain.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hvacr-catalog",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": false }
}
